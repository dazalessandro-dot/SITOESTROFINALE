---
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">

    <a href="/" class="footer-logo" aria-label="Estro — home">
      <img
        src="/branding/estro-logo-mark.png"
        alt="Estro"
        class="footer-mark"
        width="40"
        height="40"
        loading="lazy"
        decoding="async"
      />
    </a>

    <p class="footer-tagline">Wherever the work is.</p>

    <small class="footer-legal">&copy; {year} Estro</small>

  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-rule);
    padding-block: var(--space-5);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    line-height: 0;
  }

  .footer-mark {
    width: 40px;
    height: 40px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .footer-tagline {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .footer-legal {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
