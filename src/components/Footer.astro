---
const year = new Date().getFullYear();
---

<!-- No-JS nav fallback: accessible even with JS disabled -->
<nav id="menu" class="nojs-nav" aria-label="Site navigation (no-JS fallback)">
  <ul>
    <li><a href="/about">About</a></li>
    <li><a href="/what-we-do">What We Do</a></li>
    <li><a href="/projects">Projects</a></li>
    <li><a href="/contact">Contact</a></li>
  </ul>
</nav>

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">
    <span class="footer-wordmark">Estro</span>
    <p class="footer-copy"><!-- TODO: content — tagline or location --></p>
    <small class="footer-legal">&copy; {year} Estro. All rights reserved.</small>
  </div>
</footer>

<style>
  /* Hide no-JS nav when JS is available (body gets is-menu-open class only when JS runs) */
  /* We use a different approach: always hide it visually, it's only for crawlers + no-JS */
  .nojs-nav {
    padding: var(--space-5) var(--gutter);
    border-block-start: 1px solid var(--color-rule);
    background: var(--color-accent);
  }

  /* If JS is available, hide the fallback nav entirely */
  body.js-loaded .nojs-nav { display: none; }

  .nojs-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nojs-nav a {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: var(--text-sm);
  }

  .nojs-nav a:hover { text-decoration: underline; }

  /* --- Footer ------------------------------------------------- */
  .site-footer {
    border-block-start: 1px solid var(--color-rule);
    padding-block: var(--space-5);
  }

  .footer-inner {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr auto;
      align-items: center;
    }
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
  }

  .footer-copy {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .footer-legal {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>

<script>
  /* Mark body so .nojs-nav can be hidden */
  document.body.classList.add('js-loaded');
</script>
