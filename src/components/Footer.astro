---
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">

    <a href="/" class="footer-logo" aria-label="Estro — home">
      <img
        src="/favicon.svg"
        alt="Estro"
        class="footer-mark"
        width="30"
        height="30"
        loading="lazy"
        decoding="async"
      />
      <span class="footer-wordmark">ESTRO</span>
    </a>

    <p class="footer-tagline">Wherever the work is.</p>

    <small class="footer-legal">&copy; {year} Estro</small>

  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-rule);
    padding-block: var(--space-5);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    line-height: 0;
  }

  .footer-mark {
    width: 30px;
    height: 30px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    line-height: 1;
  }

  .footer-tagline {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .footer-legal {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
