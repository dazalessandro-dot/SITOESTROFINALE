---
const navLinks = [
  { href: '/services',  label: 'Services'  },
  { href: '/projects',  label: 'Projects'  },
  { href: '/culture',   label: 'Culture'   },
  { href: '/research',  label: 'Research'  },
  { href: '/contact',   label: 'Contact'   },
];
---

<header class="site-header" role="banner">
  <div class="header-inner container">

    <!-- Left: logo mark + wordmark -->
    <a href="/" class="logo-link" aria-label="Estro — home">
      <img
        src="/favicon.svg"
        alt=""
        class="logo-mark"
        width="36"
        height="36"
        loading="eager"
        decoding="async"
      />
      <span class="wordmark">ESTRO</span>
    </a>

    <!-- Centre: hamburger -->
    <button
      class="hamburger"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="menu-overlay"
      aria-label="Open navigation menu"
    >
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
    </button>

    <!-- Right: Shop → -->
    <div class="header-right">
      <a href="/shop" class="shop-link">Shop&nbsp;→</a>
    </div>

  </div>
</header>

<!-- Full-screen menu overlay -->
<div
  class="menu-overlay"
  id="menu-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
  hidden
>
  <div class="menu-overlay__header container">
    <button
      class="close-btn"
      id="menu-close"
      aria-label="Close navigation menu"
    >×</button>
  </div>

  <nav class="menu-nav" aria-label="Main">
    <ul class="menu-nav__list">
      {navLinks.map((link) => (
        <li class="menu-nav__item">
          <a href={link.href} class="menu-nav__link">{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  /* ── Header ─────────────────────────────────────────────── */
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 100;
    padding-block: var(--space-3);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  /* ── Logo ───────────────────────────────────────────────── */
  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    line-height: 0;
  }

  .logo-mark {
    width: 36px;
    height: 36px;
    object-fit: contain;
    mix-blend-mode: multiply;
    flex-shrink: 0;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-base);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    line-height: 1;
  }

  /* ── Hamburger ──────────────────────────────────────────── */
  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
  }

  .hamburger__line {
    display: block;
    width: 24px;
    height: 1.5px;
    background-color: var(--color-text);
  }

  /* ── Shop link ──────────────────────────────────────────── */
  .header-right {
    display: flex;
    justify-content: flex-end;
  }

  .shop-link {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-base);
    color: var(--color-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--easing);
  }

  .shop-link:hover { color: var(--color-text); }

  /* ── Menu overlay ───────────────────────────────────────── */
  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background-color: var(--color-accent);
    display: flex;
    flex-direction: column;
    opacity: 0;
    transition: opacity var(--duration-menu) var(--easing);
    pointer-events: none;
  }

  .menu-overlay[hidden] { display: none; }

  .menu-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .menu-overlay__header {
    display: flex;
    justify-content: flex-end;
    padding-block: var(--space-3);
    flex-shrink: 0;
  }

  /* ── Close button ───────────────────────────────────────── */
  .close-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    padding: var(--space-2);
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .close-btn:hover { opacity: 0.6; }

  /* ── Nav links ──────────────────────────────────────────── */
  .menu-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .menu-nav__list {
    border-top: 1px solid var(--color-rule);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .menu-nav__item {
    border-bottom: 1px solid var(--color-rule);
  }

  .menu-nav__link {
    display: block;
    width: 100%;
    text-align: center;
    padding: var(--space-4) var(--gutter);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 6vw, 3rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--easing);
  }

  .menu-nav__link:hover { opacity: 0.5; }

  /* Focus styles */
  .hamburger:focus-visible,
  .close-btn:focus-visible,
  .menu-nav__link:focus-visible,
  .logo-link:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }
</style>

<script>
  const toggle  = document.getElementById('menu-toggle');
  const close   = document.getElementById('menu-close');
  const overlay = document.getElementById('menu-overlay');
  const links   = overlay?.querySelectorAll('.menu-nav__link');

  function openMenu() {
    overlay?.removeAttribute('hidden');
    requestAnimationFrame(() => overlay?.classList.add('is-open'));
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('is-menu-open');
    close?.focus();
  }

  function closeMenu() {
    overlay?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('is-menu-open');
    overlay?.addEventListener('transitionend', () => overlay.setAttribute('hidden', ''), { once: true });
    toggle?.focus();
  }

  toggle?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  links?.forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay?.classList.contains('is-open')) closeMenu();
  });
</script>
