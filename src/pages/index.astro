---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Home"
  description="Estro — nomadic innovation hub. We go where the work is."
  showFooter={false}
>
  <div class="home-screen">

    <!-- Breathing area -->
    <div class="home-screen__spacer"></div>

    <!-- Bottom-anchored editorial block -->
    <div class="home-screen__content">
      <div class="home-screen__body">
        <p class="home-screen__headline">
          Nomadic innovation.<br />
          We go where the work is,<br />
          embedding with teams,<br />
          building things that matter.
        </p>
        <a href="/contact" class="home-screen__cta">Contact us</a>
      </div>
    </div>

    <!-- Bottom strip -->
    <div class="home-screen__strip">
      <span>Wherever the work is.</span>
      <span>&copy; {new Date().getFullYear()} Estro</span>
    </div>

  </div>
</BaseLayout>

<style>
  /* Override main padding — home is full-viewport */
  :global(#main-content) {
    padding-top: 0 !important;
  }

  .home-screen {
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-top: 72px; /* account for fixed nav */
  }

  .home-screen__spacer {
    flex: 1;
  }

  /* Content block — bottom-anchored */
  .home-screen__content {
    border-top: 1px solid var(--color-rule);
  }

  .home-screen__body {
    padding-inline: var(--gutter);
    padding-block: clamp(var(--space-4), 4vh, var(--space-6));
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .home-screen__headline {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 5.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  .home-screen__cta {
    align-self: flex-start;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition: opacity var(--duration-fast) var(--easing);
  }

  .home-screen__cta:hover { opacity: 0.6; }

  /* Bottom strip */
  .home-screen__strip {
    border-top: 1px solid var(--color-rule);
    padding-inline: var(--gutter);
    padding-block: var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .home-screen__strip span {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--color-muted);
  }
</style>
