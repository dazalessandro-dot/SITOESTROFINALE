---
import BaseLayout from '../layouts/BaseLayout.astro';

const words = [
  { label: 'play', color: '#ff3f6e', font: 'Cooper Black, Georgia, serif', weight: '700', style: 'normal', tracking: '0.006em' },
  { label: 'AI', color: '#174cff', font: 'Futura, Futura PT, Avenir Next, sans-serif', weight: '700', style: 'normal', tracking: '0.08em' },
  { label: 'storytelling', color: '#009b72', font: 'Georgia, Times New Roman, serif', weight: '700', style: 'italic', tracking: '0' },
  { label: 'sensemaking', color: '#f06b00', font: 'Courier New, Courier, monospace', weight: '700', style: 'normal', tracking: '-0.01em' },
  { label: 'team building', color: '#7b35ff', font: 'Gill Sans, Trebuchet MS, sans-serif', weight: '700', style: 'normal', tracking: '0.02em' },
  { label: 'sensemaking', color: '#111111', font: 'Didot, Bodoni 72, Georgia, serif', weight: '700', style: 'normal', tracking: '0.004em' },
];
---

<BaseLayout
  title="Home"
  description="Estro enhances creativity through play, AI, storytelling, sensemaking, and team building."
  showFooter={false}
>
  <section class="landing" aria-labelledby="landing-title">
    <h1 id="landing-title" class="landing__title">
      <span class="landing__fixed">we enhance creativity through</span>
      <span class="landing__word" aria-live="polite">play</span>
    </h1>
  </section>

  <script define:vars={{ words }} is:inline>
    const rotatingWord = document.querySelector('.landing__word');
    let index = 0;

    function applyWord(nextIndex) {
      const word = words[nextIndex];
      rotatingWord.textContent = word.label;
      rotatingWord.style.color = word.color;
      rotatingWord.style.fontFamily = word.font;
      rotatingWord.style.fontWeight = word.weight;
      rotatingWord.style.fontStyle = word.style;
      rotatingWord.style.letterSpacing = word.tracking;
    }

    applyWord(index);

    window.setInterval(() => {
      index = (index + 1) % words.length;
      applyWord(index);
    }, 530);
  </script>
</BaseLayout>

<style>
  :global(html),
  :global(body) {
    overflow: hidden;
  }

  :global(body) {
    min-height: 100dvh;
  }

  :global(#main-content) {
    min-height: calc(100dvh - 72px);
    animation: none !important;
  }

  .landing {
    min-height: calc(100dvh - 72px);
    width: 100%;
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 4vw, 3rem);
    background: var(--color-bg);
  }

  .landing__title {
    width: min(1180px, 100%);
    display: grid;
    grid-template-columns: 1fr;
    justify-content: center;
    row-gap: 0.1em;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5.7vw, 6.9rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: var(--display-tracking);
    text-align: center;
  }

  .landing__fixed {
    white-space: nowrap;
  }

  .landing__word {
    display: block;
    min-height: 1em;
    font-weight: 700;
    letter-spacing: var(--display-tracking-tight);
    white-space: nowrap;
    text-align: center;
    vertical-align: baseline;
  }

  @media (max-width: 700px) {
    .landing {
      place-items: center;
      padding: clamp(1rem, 5vw, 1.6rem);
    }

    .landing__title {
      row-gap: 0.14em;
      font-size: clamp(2.3rem, 12vw, 4.8rem);
      text-align: center;
      transform: translateY(-7dvh);
    }

    .landing__fixed,
    .landing__word {
      white-space: normal;
    }
  }
</style>
