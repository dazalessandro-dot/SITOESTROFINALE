---
import BaseLayout from '../layouts/BaseLayout.astro';

const words = [
  { label: 'play', color: '#ff4f7b', font: 'DeFontePlus, Avenir Next, sans-serif' },
  { label: 'AI', color: '#2454ff', font: 'Futura, Futura PT, Avenir Next, sans-serif' },
  { label: 'storytelling', color: '#008f6f', font: 'Georgia, Times New Roman, serif' },
  { label: 'sensemaking', color: '#e16a00', font: 'DeFontePlus, Avenir Next, sans-serif' },
  { label: 'team building', color: '#7b3ff2', font: 'Helvetica Neue, Arial, sans-serif' },
  { label: 'sensemaking', color: '#111111', font: 'Futura, Futura PT, Avenir Next, sans-serif' },
];
---

<BaseLayout
  title="Home"
  description="Estro enhances creativity through play, AI, storytelling, sensemaking, and team building."
  showFooter={false}
>
  <section class="landing" aria-labelledby="landing-title">
    <h1 id="landing-title" class="landing__title">
      <span class="landing__fixed">we enhance creativity through</span>
      <span class="landing__word" aria-live="polite">play</span>
    </h1>
  </section>

  <script define:vars={{ words }} is:inline>
    const rotatingWord = document.querySelector('.landing__word');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;

    function applyWord(nextIndex) {
      const word = words[nextIndex];
      rotatingWord.textContent = word.label;
      rotatingWord.style.color = word.color;
      rotatingWord.style.fontFamily = word.font;
    }

    applyWord(index);

    if (!reduceMotion) {
      window.setInterval(() => {
        rotatingWord.classList.add('is-changing');

        window.setTimeout(() => {
          index = (index + 1) % words.length;
          applyWord(index);
          rotatingWord.classList.remove('is-changing');
        }, 180);
      }, 950);
    }
  </script>
</BaseLayout>

<style>
  :global(html),
  :global(body) {
    overflow: hidden;
  }

  :global(body) {
    min-height: 100dvh;
  }

  :global(#main-content) {
    min-height: calc(100dvh - 72px);
    animation: none !important;
  }

  .landing {
    min-height: calc(100dvh - 72px);
    width: 100%;
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 4vw, 3rem);
    background: var(--color-bg);
  }

  .landing__title {
    width: min(1180px, 100%);
    display: grid;
    grid-template-columns: 1fr;
    justify-content: center;
    row-gap: 0.1em;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5.7vw, 6.9rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: var(--display-tracking);
    text-align: center;
  }

  .landing__fixed {
    white-space: nowrap;
  }

  .landing__word {
    display: block;
    min-height: 1em;
    font-weight: 700;
    letter-spacing: var(--display-tracking-tight);
    white-space: nowrap;
    text-align: center;
    transition:
      color 220ms ease,
      opacity 180ms ease,
      transform 180ms ease;
    vertical-align: baseline;
  }

  .landing__word.is-changing {
    opacity: 0;
    transform: translateY(0.16em);
  }

  @media (max-width: 700px) {
    .landing {
      place-items: center;
      padding: clamp(1rem, 5vw, 1.6rem);
    }

    .landing__title {
      row-gap: 0.14em;
      font-size: clamp(2.3rem, 12vw, 4.8rem);
      text-align: center;
      transform: translateY(-7dvh);
    }

    .landing__fixed,
    .landing__word {
      white-space: normal;
    }
  }
</style>
