---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Home"
  description="Estro — nomadic innovation hub. We go where the work is."
  showFooter={false}
>
  <div class="home-screen">

    <!-- Immediate editorial + contact block -->
    <div class="home-screen__content">
      <div class="home-screen__body">
        <p class="home-screen__headline">
          Nomadic innovation.<br />
          We go where the work is,<br />
          embedding with teams,<br />
          building things that matter.
        </p>
        <div class="home-screen__contact" aria-label="Contact">
          <a href="mailto:hello@estro.io" class="home-screen__contact-link">hello@estro.io</a>
          <span>Wherever the work is.</span>
        </div>
      </div>
    </div>

    <!-- Bottom strip -->
    <div class="home-screen__strip">
      <span>Contact</span>
      <span>&copy; {new Date().getFullYear()} Estro</span>
    </div>

  </div>
</BaseLayout>

<style>
  /* Override main padding — home is full-viewport */
  :global(#main-content) {
    padding-top: 0 !important;
    background: #fff;
  }

  .home-screen {
    height: 100dvh;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    padding-top: 72px; /* account for fixed nav */
    background: #fff;
  }

  /* Content block — vertically centred */
  .home-screen__content {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .home-screen__body {
    padding-inline: var(--gutter);
    padding-block: clamp(var(--space-4), 4vh, var(--space-6));
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(var(--space-5), 9vw, var(--space-6));
    width: 100%;
  }

  .home-screen__headline {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 5.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0;
    max-width: 22ch;
  }

  .home-screen__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: max-content;
  }

  .home-screen__contact,
  .home-screen__contact-link {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .home-screen__contact span {
    color: var(--color-muted);
    font-weight: 300;
  }

  .home-screen__contact-link {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition: opacity var(--duration-fast) var(--easing);
  }

  .home-screen__contact-link:hover { opacity: 0.6; }

  /* Bottom strip */
  .home-screen__strip {
    padding-inline: var(--gutter);
    padding-block: var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .home-screen__strip span {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .home-screen {
      min-height: 100dvh;
      height: 100dvh;
      padding-top: 72px;
      grid-template-rows: 1fr auto;
    }

    .home-screen__content {
      align-items: center;
      justify-content: center;
      padding-inline: var(--gutter);
    }

    .home-screen__body {
      width: min(100%, 22rem);
      min-height: 61dvh;
      justify-content: center;
      align-items: center;
      gap: clamp(var(--space-5), 9vh, var(--space-6));
      padding: 0;
      text-align: center;
      display: flex;
      flex-direction: column;
    }

    .home-screen__headline {
      font-size: clamp(2rem, 11vw, 3.2rem);
      font-weight: 400;
      line-height: 0.98;
      max-width: 9.5ch;
      text-wrap: balance;
    }

    .home-screen__contact {
      align-items: center;
      min-width: 0;
      max-width: 100%;
      gap: var(--space-2);
    }

    .home-screen__contact,
    .home-screen__contact-link {
      font-size: 0.82rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .home-screen__contact-link {
      text-decoration: none;
      border: 1px solid currentColor;
      border-radius: 999px;
      padding: 0.75rem 1rem;
      line-height: 1;
    }

    .home-screen__strip {
      padding-block: var(--space-4);
      align-items: flex-end;
    }

    .home-screen__strip span {
      font-size: 0.68rem;
      line-height: 1.2;
    }

    .home-screen__strip span:first-child { max-width: 9ch; }
  }
</style>
