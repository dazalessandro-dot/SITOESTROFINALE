---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/editorial-pages.css';

const disciplines = [
  {
    title: 'Creative culture & team',
    body: 'Culture strategy, facilitation, internal storytelling, and leadership support for organisations that need better shared energy and clearer patterns of collaboration.',
  },
  {
    title: 'Futures & innovation',
    body: 'Signals, scenarios, opportunity framing, and concept development for teams moving toward a market or technological shift they cannot ignore.',
  },
  {
    title: 'Product & experience',
    body: 'Product strategy, interface direction, prototyping, and decision support for offers that need to become clearer, more coherent, and more resilient.',
  },
];

const process = [
  {
    label: '01',
    title: 'Read the terrain',
    body: 'We start by understanding what is actually blocked, what is merely noisy, and what kind of decision the team is truly facing.',
  },
  {
    label: '02',
    title: 'Shape the frame',
    body: 'Then we tighten the brief, define the level of ambition, and choose the right working format for the moment.',
  },
  {
    label: '03',
    title: 'Make it tangible',
    body: 'Concepts become proposals, prototypes, systems, narratives, or rituals that people can respond to in concrete terms.',
  },
];
---

<BaseLayout
  title="Services"
  description="Strategy, culture, futures, and product services delivered from inside your team."
>
  <div class="editorial-page">
    <section class="editorial-hero">
      <div class="container editorial-grid">
        <div class="editorial-rail" data-reveal="hero-meta">
          <p class="section-label">Services</p>
          <p class="editorial-rail-note">Three connected practice areas, held together by one method: get close, frame well, and make the work usable.</p>
        </div>

        <div class="editorial-main" data-reveal="hero-content">
          <h1 class="editorial-title editorial-title--wide">Strategy, culture, and product thinking for teams already in motion.</h1>
          <p class="editorial-intro">
            Our services are less a menu than a set of working disciplines. Most engagements move across them as the real shape of the problem becomes clearer.
          </p>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Practice areas</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">The work usually enters through one door, then expands into adjacent decisions.</h2>
          <div class="editorial-card-grid">
            {disciplines.map((discipline) => (
              <article class="editorial-card" data-reveal="card">
                <p class="editorial-card__title">{discipline.title}</p>
                <p class="editorial-card__body">{discipline.body}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Method</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">The service is not just expertise. It is the quality of attention applied to a live problem.</h2>
          <div class="editorial-list">
            {process.map((step) => (
              <article class="editorial-row" data-reveal="row">
                <p class="editorial-row__index">{step.label}</p>
                <div class="editorial-row__content">
                  <h3 class="editorial-row__title">{step.title}</h3>
                  <p class="editorial-row__body">{step.body}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
