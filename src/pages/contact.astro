---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Estro."
  showFooter={false}
>
  <section class="contact-page">
    <div class="container contact-page__inner">
      <h1 class="contact-page__title">contact</h1>

      <div class="contact-page__details">
        <a href="mailto:hello@estro.io" class="contact-page__email">hello@estro.io</a>
        <p>Wherever the work is.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    min-height: calc(100dvh - 72px);
    display: grid;
    align-items: center;
    padding-block: clamp(5rem, 12vw, 9rem);
  }

  .contact-page__inner {
    display: grid;
    grid-template-columns: 1fr minmax(18rem, 0.7fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .contact-page__title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 15vw, 14rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: var(--display-tracking);
    color: var(--color-text);
  }

  .contact-page__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.4;
    color: var(--color-muted);
  }

  .contact-page__email {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.8vw, 4rem);
    line-height: 1;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .contact-page__email:hover {
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .contact-page {
      align-items: end;
      padding-block: var(--space-5);
    }

    .contact-page__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      align-items: start;
    }
  }
</style>
