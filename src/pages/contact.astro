---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  ['Instagram', '#'],
  ['LinkedIn', '#'],
  ['Are.na', '#'],
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Estro — hello@estro.io"
  showFooter={false}
>
  <section class="contact-signal" aria-labelledby="contact-title">
    <p>Contact</p>
    <h1 id="contact-title">Send the unfinished thing.</h1>
    <a class="contact-email" href="mailto:hello@estro.io">hello@estro.io</a>

    <div class="contact-orbit" aria-hidden="true">
      <span></span>
      <span></span>
    </div>
  </section>

  <section class="contact-lines" aria-label="Other contact routes">
    <p>Wherever the work is.</p>
    <ul role="list">
      {links.map(([label, href]) => (
        <li>
          <a href={href}>{label}<span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  :global(#main-content) {
    padding-top: 0 !important;
    background: #050505;
  }

  .contact-signal,
  .contact-lines {
    padding-inline: var(--gutter);
  }

  .contact-signal {
    min-height: 100svh;
    padding-top: calc(72px + var(--space-4));
    padding-bottom: var(--space-5);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: #050505;
    color: #fff;
  }

  .contact-signal > p {
    margin-bottom: clamp(var(--space-5), 16vh, var(--space-6));
    color: rgba(255,255,255,0.48);
    font-size: 0.78rem;
  }

  .contact-signal h1 {
    position: relative;
    z-index: 2;
    max-width: 8ch;
    font-family: var(--font-display);
    font-size: clamp(4rem, 13vw, 10rem);
    font-weight: 400;
    line-height: 0.86;
  }

  .contact-email {
    position: relative;
    z-index: 2;
    width: max-content;
    margin-top: var(--space-5);
    color: #fff;
    font-size: clamp(1.25rem, 3vw, 2.4rem);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .contact-orbit {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .contact-orbit span {
    position: absolute;
    display: block;
    border: 1px solid rgba(255,255,255,0.09);
  }

  .contact-orbit span:first-child {
    width: min(50vw, 42rem);
    height: min(62vw, 50rem);
    right: -10vw;
    top: 14svh;
    background: #d93430;
    opacity: 0.86;
    transform: rotate(7deg);
  }

  .contact-orbit span:last-child {
    width: min(36vw, 30rem);
    height: min(22vw, 18rem);
    right: 14vw;
    bottom: 9svh;
    background: rgba(255,255,255,0.88);
    transform: rotate(-4deg);
  }

  .contact-lines {
    min-height: 70svh;
    padding-block: var(--space-6);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.55fr);
    gap: var(--space-6);
    align-items: end;
    background: #f7f7f5;
    color: var(--color-text);
  }

  .contact-lines p {
    max-width: 8ch;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 8vw, 6rem);
    line-height: 0.92;
  }

  .contact-lines ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-lines a {
    color: var(--color-text);
    text-decoration: none;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
  }

  .contact-lines span {
    display: inline-block;
    margin-left: var(--space-2);
    color: #d93430;
    transition: transform 160ms ease;
  }

  .contact-lines a:hover span {
    transform: translateX(0.35rem);
  }

  @media (max-width: 640px) {
    .contact-signal h1 {
      font-size: clamp(3rem, 14vw, 4.9rem);
      max-width: 7.4ch;
    }

    .contact-orbit span:first-child {
      width: 62vw;
      height: 82vw;
      right: -24vw;
      top: 15svh;
    }

    .contact-orbit span:last-child {
      width: 48vw;
      height: 28vw;
      right: -7vw;
      bottom: 11svh;
    }

    .contact-lines {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
    }
  }
</style>
