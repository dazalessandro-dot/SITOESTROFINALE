---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Estro — hello@estro.io"
>

  <section class="page-header">
    <div class="container">
      <h1 class="page-title">Contact</h1>
    </div>
  </section>

  <hr class="rule" />

  <section class="section" aria-label="Contact">
    <div class="container contact-layout">

      <!-- Info -->
      <div class="contact-info">
        <p class="section-label">Get in touch</p>

        <div class="contact-info__row">
          <p class="contact-info__label">Email</p>
          <a href="mailto:hello@estro.io" class="contact-info__value">hello@estro.io</a>
        </div>

        <div class="contact-info__row">
          <p class="contact-info__label">Location</p>
          <p class="contact-info__value">Wherever the work is.</p>
        </div>

        <div class="contact-info__row">
          <p class="contact-info__label">Follow</p>
          <div class="social-links">
            <a href="#" class="social-link">Instagram</a>
            <a href="#" class="social-link">LinkedIn</a>
            <a href="#" class="social-link">Are.na</a>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="contact-form-wrap">
        <p class="section-label">Send a message</p>

        <form class="contact-form" id="contact-form" novalidate>
          <div class="form-field">
            <label for="name" class="form-label">Name</label>
            <input type="text" id="name" name="name" required autocomplete="name" class="form-input" />
          </div>

          <div class="form-field">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" class="form-input" />
          </div>

          <div class="form-field">
            <label for="message" class="form-label">Message</label>
            <textarea id="message" name="message" required rows="5" class="form-input form-textarea"></textarea>
          </div>

          <button type="submit" class="form-submit">Send</button>
        </form>

        <div class="form-thanks" id="form-thanks" hidden>
          <p class="thanks-heading">Thank you.</p>
          <p class="thanks-body">We will be in touch.</p>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .page-header { padding-block: var(--space-5); }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .section { padding-block: var(--space-6); }

  /* Layout */
  .contact-layout {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  /* Info */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .contact-info__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: var(--space-1);
  }

  .contact-info__value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--color-text);
    text-decoration: none;
  }

  a.contact-info__value:hover { text-decoration: underline; text-underline-offset: 3px; }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .social-link {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-text);
    opacity: 0.7;
    transition: opacity var(--duration-fast);
  }

  .social-link:hover { opacity: 1; }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-field { display: flex; flex-direction: column; }

  .form-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: var(--space-1);
  }

  .form-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-rule);
    padding-block: var(--space-3);
    font-size: var(--text-base);
    font-family: var(--font-body);
    font-weight: 400;
    color: var(--color-text);
    outline: none;
    border-radius: 0;
    appearance: none;
  }

  .form-input:focus {
    border-bottom-color: var(--color-text);
  }

  .form-textarea { resize: vertical; }

  .form-submit {
    align-self: flex-start;
    background: var(--color-text);
    color: var(--color-bg);
    border: none;
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity var(--duration-fast) var(--easing);
  }

  .form-submit:hover { opacity: 0.75; }

  /* Thank you state */
  .form-thanks { padding-block: var(--space-6); }

  .thanks-heading {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  .thanks-body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>

<script>
  const form   = document.getElementById('contact-form') as HTMLFormElement | null;
  const thanks = document.getElementById('form-thanks');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.hidden = true;
    if (thanks) thanks.hidden = false;
  });
</script>
