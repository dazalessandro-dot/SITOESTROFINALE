---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/editorial-pages.css';

const channels = [
  { label: 'Email', value: 'hello@estro.io', href: 'mailto:hello@estro.io' },
  { label: 'Base', value: 'Wherever the work is.', href: '' },
  { label: 'Follow', value: 'Instagram / LinkedIn / Are.na', href: '' },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Estro."
>
  <div class="editorial-page contact-page">
    <section class="editorial-hero">
      <div class="container editorial-grid">
        <div class="editorial-rail" data-reveal="hero-meta">
          <p class="section-label">Contact</p>
          <p class="editorial-rail-note">Tell us what the team is trying to move, what is stuck, or what kind of shape the next phase needs.</p>
        </div>

        <div class="editorial-main" data-reveal="hero-content">
          <h1 class="editorial-title editorial-title--wide">If the work matters, it is probably worth the conversation.</h1>
          <p class="editorial-intro">
            We work with companies, founders, and operators who need clarity under pressure. Strange questions are welcome. So are early signals of something not fully formed yet.
          </p>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Reach us</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <div class="editorial-columns contact-columns">
            <div class="contact-page__info">
              {channels.map((channel) => (
                <div class="contact-page__row">
                  <p class="editorial-card__meta">{channel.label}</p>
                  {channel.href ? (
                    <a href={channel.href} class="contact-page__value">{channel.value}</a>
                  ) : (
                    <p class="contact-page__value">{channel.value}</p>
                  )}
                </div>
              ))}
            </div>

            <div class="contact-page__form-wrap">
              <form class="contact-page__form" id="contact-form" novalidate>
                <div class="contact-page__field">
                  <label for="name" class="editorial-card__meta">Name</label>
                  <input type="text" id="name" name="name" required autocomplete="name" class="contact-page__input" />
                </div>

                <div class="contact-page__field">
                  <label for="email" class="editorial-card__meta">Email</label>
                  <input type="email" id="email" name="email" required autocomplete="email" class="contact-page__input" />
                </div>

                <div class="contact-page__field">
                  <label for="message" class="editorial-card__meta">Message</label>
                  <textarea id="message" name="message" required rows="5" class="contact-page__input contact-page__textarea"></textarea>
                </div>

                <button type="submit" class="editorial-cta contact-page__submit">Send message</button>
              </form>

              <div class="contact-page__thanks" id="form-thanks" hidden>
                <p class="editorial-headline">Thank you.</p>
                <p class="editorial-text">We will be in touch.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-columns {
    align-items: start;
  }

  .contact-page__info,
  .contact-page__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .contact-page__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .contact-page__value {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .contact-page__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .contact-page__input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-rule);
    padding-block: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text);
    outline: none;
    border-radius: 0;
    appearance: none;
  }

  .contact-page__textarea {
    resize: vertical;
  }

  .contact-page__submit {
    background: none;
    margin-top: var(--space-2);
  }

  .contact-page__thanks {
    padding-block: var(--space-5);
  }
</style>

<script>
  const form = document.getElementById('contact-form');
  const thanks = document.getElementById('form-thanks');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    form.hidden = true;
    if (thanks) thanks.hidden = false;
  });
</script>
