---
import BaseLayout from '../layouts/BaseLayout.astro';

const programs = [
  {
    label: 'Residency',
    desc: 'A multi-week embed with your team. We show up at your location, work alongside the people closest to the problem, and help you move from stuck to shipped.',
  },
  {
    label: 'Sprint',
    desc: 'Five days. One problem. Tangible output. Structured co-creation that cuts through noise and produces something you can test, ship, or fund.',
  },
  {
    label: 'Advisory',
    desc: 'Ongoing strategic guidance for founders and operators navigating new territory. Monthly calls, open access between sessions, honest opinions.',
  },
  {
    label: 'Venture',
    desc: 'We co-found. If you have the domain knowledge and the team, we bring the innovation process — and sometimes the capital. We share the risk; we share the upside.',
  },
];

const services = [
  'Innovation strategy',
  'Product design & prototyping',
  'Team facilitation & workshops',
  'Venture building',
  'Stakeholder alignment',
  'Go-to-market planning',
];
---

<BaseLayout
  title="What We Do"
  description="Residencies, sprints, advisory, and venture building — designed around the work, not the calendar."
>

  <section class="page-header">
    <div class="container">
      <h1 class="page-title">What We Do</h1>
    </div>
  </section>

  <hr class="rule" />

  <!-- Overview -->
  <section class="section" aria-labelledby="overview-heading">
    <div class="container">
      <p id="overview-heading" class="section-label">Overview</p>
      <p class="lead-text" style="max-width: 40ch;">
        Focused engagements — residencies, sprints, and long-term partnerships — designed around the work, not the calendar.
      </p>
    </div>
  </section>

  <hr class="rule" />

  <!-- Programs -->
  <section class="section-tight" aria-labelledby="programs-heading">
    <div class="container">
      <p id="programs-heading" class="section-label">Programs &amp; Formats</p>
      <ul class="programs-list" role="list">
        {programs.map((p, i) => (
          <li class="program-item">
            <hr class="rule" />
            <div class="program-item__inner">
              <span class="program-item__index">0{i + 1}</span>
              <div class="program-item__body">
                <p class="program-item__name">{p.label}</p>
                <p class="program-item__desc">{p.desc}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <hr class="rule" />
    </div>
  </section>

  <hr class="rule" />

  <!-- Services -->
  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <p id="services-heading" class="section-label">Services</p>
      <ul class="services-list" role="list">
        {services.map((s) => (
          <li class="service-item">
            <span class="service-item__dash">—</span>
            <span class="service-item__name">{s}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>

<style>
  .page-header { padding-block: var(--space-5); }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .section       { padding-block: var(--space-6); }
  .section-tight { padding-block: var(--space-5); }

  .lead-text {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    font-weight: 400;
    line-height: 1.35;
  }

  /* Programs */
  .programs-list { list-style: none; padding: 0; margin: 0; }

  .program-item__inner {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-5);
    align-items: start;
  }

  .program-item__index {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--color-muted);
    padding-top: 0.3em;
  }

  .program-item__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    margin-bottom: var(--space-3);
  }

  .program-item__desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-muted);
    line-height: 1.75;
    max-width: 52ch;
  }

  /* Services */
  .services-list { list-style: none; padding: 0; margin: 0; }

  .service-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .service-item__dash {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 300;
    color: var(--color-muted);
    min-width: 1.5rem;
  }

  .service-item__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
  }
</style>
