---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/editorial-pages.css';

const programs = [
  {
    label: '01',
    title: 'Residency',
    body: 'A multi-week embed with your team. We work at operating distance, helping decisions become direction and direction become output.',
  },
  {
    label: '02',
    title: 'Sprint',
    body: 'A concentrated week for moments that need pace, alignment, and something concrete by the end of it.',
  },
  {
    label: '03',
    title: 'Advisory',
    body: 'An ongoing outside perspective for founders and operators navigating complexity, transition, or new opportunity.',
  },
  {
    label: '04',
    title: 'Venture build',
    body: 'When the opportunity is strong enough, we help shape new initiatives from early concept to more durable operating form.',
  },
];

const services = [
  {
    title: 'Direction finding',
    body: 'Positioning, opportunity framing, initiative shaping, and decision support for teams that need sharper strategic movement.',
  },
  {
    title: 'Design systems',
    body: 'Product thinking, interface direction, experience shaping, and prototypes that make a future state visible and discussable.',
  },
  {
    title: 'Team acceleration',
    body: 'Workshops, facilitation, communication structure, and leadership alignment for teams that need shared motion rather than more noise.',
  },
  {
    title: 'AI studio',
    body: 'AI-assisted exploration, prototyping, and workflow design translated into creative tools a team can actually use.',
  },
];
---

<BaseLayout
  title="What We Do"
  description="Formats, engagements, and the kinds of work Estro is built to take on."
>
  <div class="editorial-page">
    <section class="editorial-hero">
      <div class="container editorial-grid">
        <div class="editorial-rail" data-reveal="hero-meta">
          <p class="section-label">What we do</p>
          <p class="editorial-rail-note">Engagements designed around the work itself, not around a generic consulting calendar.</p>
        </div>

        <div class="editorial-main" data-reveal="hero-content">
          <h1 class="editorial-title editorial-title--wide">Focused formats for teams that need momentum, shape, and better shared judgment.</h1>
          <p class="editorial-intro">
            We work in a few clear modes so the collaboration stays legible. What changes is the intensity, the proximity, and the kind of decision the team needs to make.
          </p>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Formats</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">A small set of engagement shapes, used deliberately.</h2>
          <div class="editorial-list">
            {programs.map((program) => (
              <article class="editorial-row" data-reveal="row">
                <p class="editorial-row__index">{program.label}</p>
                <div class="editorial-row__content">
                  <h3 class="editorial-row__title">{program.title}</h3>
                  <p class="editorial-row__body">{program.body}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Capabilities</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">The work usually lives somewhere between strategy, design, teams, and future-facing change.</h2>
          <div class="editorial-card-grid">
            {services.map((service) => (
              <article class="editorial-card" data-reveal="card">
                <p class="editorial-card__title">{service.title}</p>
                <p class="editorial-card__body">{service.body}</p>
              </article>
            ))}
          </div>

          <a href="/services" class="editorial-cta" data-reveal="cta">See service detail</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
