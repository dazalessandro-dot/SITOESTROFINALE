---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI Studio"
  description="AI Studio from Estro. Coming soon."
  showFooter={false}
>
  <section class="ai-page">
    <div class="container ai-page__inner">
      <h1>Coming soon.</h1>
    </div>
  </section>
</BaseLayout>

<style>
  .ai-page {
    min-height: calc(100dvh - 72px);
    display: grid;
    align-items: center;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .ai-page__inner {
    display: grid;
    place-items: center;
  }

  .ai-page h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 6rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: var(--display-tracking);
    text-align: center;
    color: var(--color-text);
  }
</style>
