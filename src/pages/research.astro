---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/editorial-pages.css';

const writing = [
  {
    label: 'Essay',
    title: 'What teams misread when they say they need innovation',
    body: 'A field note on the gap between wanting novelty and building the organisational conditions that let better work survive.',
  },
  {
    label: 'Dispatch',
    title: 'Futures work is most useful when it changes present decisions',
    body: 'An argument for research that does not stay in the realm of inspiration but travels into product, operating, and leadership choices.',
  },
  {
    label: 'Observation',
    title: 'Why editorial judgment matters more as teams move faster',
    body: 'A short piece on sequencing, narrative clarity, and why not every important decision should look like a framework.',
  },
];

const themes = [
  'AI-enabled experience design',
  'Distributed team behavior',
  'Service language and operational clarity',
  'Signals of cultural and product change',
];
---

<BaseLayout
  title="Research"
  description="Writing, observations, and field notes from Estro."
>
  <div class="editorial-page">
    <section class="editorial-hero">
      <div class="container editorial-grid">
        <div class="editorial-rail" data-reveal="hero-meta">
          <p class="section-label">Research</p>
          <p class="editorial-rail-note">Writing from the field on design, futures, organisational behavior, and the shape of work in transition.</p>
        </div>

        <div class="editorial-main" data-reveal="hero-content">
          <h1 class="editorial-title editorial-title--wide">A place for the questions that deserve more than a slide.</h1>
          <p class="editorial-intro">
            Research at Estro is not a separate thought-leadership layer. It is how we keep our practice alert, useful, and in contact with changes that are still taking shape.
          </p>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Writing</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">Short essays, observations, and working notes from active client contexts.</h2>
          <div class="editorial-list">
            {writing.map((item, index) => (
              <article class="editorial-row" data-reveal="row">
                <p class="editorial-row__index">0{index + 1}</p>
                <div class="editorial-row__content">
                  <div>
                    <p class="editorial-card__meta">{item.label}</p>
                    <h3 class="editorial-row__title">{item.title}</h3>
                  </div>
                  <p class="editorial-row__body">{item.body}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Themes</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">The topics we keep returning to as the work evolves.</h2>
          <div class="editorial-card-grid">
            {themes.map((theme) => (
              <article class="editorial-card" data-reveal="card">
                <p class="editorial-card__title">{theme}</p>
                <p class="editorial-card__body">These are the lenses we use to make weak signals more discussable and future pressure more actionable for teams working in the present.</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
