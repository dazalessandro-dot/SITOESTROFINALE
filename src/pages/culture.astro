---
import BaseLayout from '../layouts/BaseLayout.astro';

const matrixCells = [
  {
    axes: 'Culture × Play',
    title: 'Creative confidence',
    body: 'Collective imagination, shared energy, new ways to participate.',
  },
  {
    axes: 'Technology × Play',
    title: 'Creative tools',
    body: 'New ways to generate, remix, test, and make ideas visible.',
  },
  {
    axes: 'Culture × Research',
    title: 'People and contexts',
    body: 'Field observation, workplace culture, generational perspectives.',
  },
  {
    axes: 'Technology × Research',
    title: 'Possible futures',
    body: 'Prototypes, scenarios, and visual systems for uncertainty.',
  },
];

const outputs = [
  'workshops and creative tools',
  'future scenarios',
  'branding and product design',
];

const diamondNotes = [
  'Workshops that open new perspectives.',
  'Tools that help teams generate together.',
  'Formats that make divergence usable.',
];
---

<BaseLayout
  title="Culture"
  description="Estro is a diverse creative community working between culture and technology."
>
  <article class="culture-page">
    <section class="culture-hero">
      <div class="container culture-hero__inner">
        <p class="culture-label" data-reveal="hero-meta">Culture</p>
        <div class="culture-hero__copy" data-reveal="hero-content">
          <h1>Creativity is a collective capability.</h1>
          <p>
            Estro is a diverse creative community working between culture and technology. We help teams imagine further, create together and turn uncertainty into possibilities.
          </p>
        </div>
      </div>
    </section>

    <section class="culture-matrix-section" aria-labelledby="matrix-title">
      <div class="container culture-section-grid">
        <div class="culture-section-heading">
          <p class="culture-label">Matrix</p>
          <h2 id="matrix-title">Four dimensions, one practice.</h2>
        </div>

        <div class="culture-matrix" aria-label="Culture, technology, play and research matrix">
          <span class="matrix-axis matrix-axis--top">Play</span>
          <span class="matrix-axis matrix-axis--bottom">Research</span>
          <span class="matrix-axis matrix-axis--left">Culture</span>
          <span class="matrix-axis matrix-axis--right">Technology</span>

          <div class="matrix-grid">
            {matrixCells.map((cell) => (
              <article>
                <p>{cell.axes}</p>
                <h3>{cell.title}</h3>
                <span>{cell.body}</span>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="culture-visual culture-visual--spiral" aria-labelledby="spiral-title">
      <div class="container culture-visual__inner">
        <div class="culture-section-heading">
          <p class="culture-label">Loop</p>
          <h2 id="spiral-title">Imagine. Create. Experiment. Learn. Open wider.</h2>
          <p class="culture-section-copy">
            The spiral describes how Estro works across projects: each cycle creates an outcome and new learning for the studio and for the organisation.
          </p>
        </div>
        <div class="culture-diagram-block">
          <figure class="culture-visual__media">
            <img
              src="/culture/spiral.png"
              alt="Spiral process diagram with the phases Imagine, Create and Experiment."
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <section class="culture-visual culture-visual--diamond" aria-labelledby="diamond-title">
      <div class="container culture-visual__inner">
        <div class="culture-section-heading">
          <p class="culture-label">Method</p>
          <h2 id="diamond-title">Make more room for the unexpected.</h2>
          <p class="culture-section-copy">
            We help organisations become more divergent through workshops, creative tools and collaborative formats that expand how people imagine before they decide.
          </p>
        </div>
        <div class="culture-diagram-block">
          <figure class="culture-visual__media culture-visual__media--wide">
            <img
              src="/culture/double-diamond.png"
              alt="Overlapping Double Diamond diagram with a wider red exploration path around a black reference diagram."
              loading="lazy"
              decoding="async"
            />
            <svg class="diamond-expansion" viewBox="0 0 100 56.25" preserveAspectRatio="none" aria-hidden="true">
              <path class="diamond-expansion__field" d="M3 28.1 C15 4.5 30 4.5 42 28.1 C54 51.6 72 52.8 97 28.1" />
              <path class="diamond-expansion__field diamond-expansion__field--inner" d="M8 28.1 C18 11 30 10.5 40 28.1 C52 46.4 70 46.8 92 28.1" />
              <path class="diamond-expansion__dash" d="M1 28.1 C14 -1 32 -2 45 28.1 C58 58.5 77 59.2 99 28.1" />
              <circle cx="3" cy="28.1" r="1.2" />
              <circle cx="42" cy="28.1" r="1.2" />
              <circle cx="97" cy="28.1" r="1.2" />
            </svg>
          </figure>
          <ul class="diamond-notes" aria-label="Double Diamond explanation">
            {diamondNotes.map((note) => <li>{note}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="ai-quote-section" aria-labelledby="ai-title">
      <div class="container ai-quote-section__inner">
        <p class="culture-label">AI and creativity</p>
        <blockquote>
          <p id="ai-title">“As AI perfects, we must disrupt. Our role is to reintroduce human quirks and make things interesting again.”</p>
          <cite>
            <a href="https://www.weforum.org/stories/all/ai-and-need-for-more-human-creativity/" target="_blank" rel="noopener noreferrer">
              Yasuharu Sasaki, Global Chief Creative Officer, dentsu
            </a>
          </cite>
        </blockquote>
        <p class="ai-quote-section__note">When making gets easier, how we imagine together matters more.</p>
      </div>
    </section>

    <section class="culture-close">
      <div class="container culture-close__inner">
        <h2>What this becomes.</h2>
        <ul aria-label="How Estro culture becomes studio work">
          {outputs.map((output) => (
            <li>{output}</li>
          ))}
        </ul>
        <a href="/contact">Start a conversation <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .culture-page {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .culture-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .culture-hero {
    min-height: calc(92dvh - 72px);
    display: flex;
    align-items: end;
    padding-block: clamp(5rem, 12vw, 9rem) clamp(3rem, 6vw, 5rem);
  }

  .culture-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.18fr) minmax(0, 0.82fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: start;
  }

  .culture-hero__copy {
    display: grid;
    gap: clamp(1.6rem, 3vw, 2.6rem);
  }

  .culture-hero h1 {
    max-width: 11ch;
    font-family: var(--font-display);
    font-size: clamp(3.8rem, 8.8vw, 8.8rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: var(--display-tracking-tight);
  }

  .culture-hero p:not(.culture-label) {
    max-width: 42rem;
    font-family: var(--font-body);
    font-size: clamp(1.12rem, 1.8vw, 1.55rem);
    line-height: 1.34;
    color: var(--color-muted);
  }

  .culture-section-grid,
  .culture-visual__inner,
  .ai-quote-section__inner,
  .culture-close__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.28fr) minmax(0, 0.72fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: start;
  }

  .culture-section-heading {
    display: grid;
    gap: var(--space-4);
    position: sticky;
    top: 96px;
  }

  .culture-section-heading h2,
  .culture-close h2 {
    max-width: 11ch;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.2vw, 4.8rem);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: var(--display-tracking-tight);
  }

  .culture-section-copy {
    max-width: 32rem;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.3vw, 1.16rem);
    line-height: 1.48;
    color: var(--color-muted);
  }

  .culture-matrix-section,
  .culture-visual,
  .ai-quote-section,
  .culture-close {
    padding-block: clamp(4rem, 8vw, 8rem);
    border-top: 1px solid rgba(17, 17, 17, 0.16);
  }

  .culture-matrix {
    position: relative;
    min-height: clamp(34rem, 54vw, 48rem);
    padding: clamp(2.6rem, 5vw, 4.5rem);
  }

  .culture-matrix::before,
  .culture-matrix::after {
    content: '';
    position: absolute;
    background: rgba(17, 17, 17, 0.28);
  }

  .culture-matrix::before {
    left: 50%;
    top: 1.2rem;
    bottom: 1.2rem;
    width: 1px;
  }

  .culture-matrix::after {
    left: 1.2rem;
    right: 1.2rem;
    top: 50%;
    height: 1px;
  }

  .matrix-axis {
    position: absolute;
    z-index: 2;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.9rem);
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .matrix-axis--top {
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .matrix-axis--bottom {
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .matrix-axis--left {
    left: 0;
    top: 50%;
    transform: translateY(-50%) rotate(-90deg);
    transform-origin: center;
  }

  .matrix-axis--right {
    right: 0;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    transform-origin: center;
  }

  .matrix-grid {
    height: 100%;
    min-height: inherit;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgba(17, 17, 17, 0.18);
    border: 1px solid rgba(17, 17, 17, 0.18);
  }

  .matrix-grid article {
    min-height: 16rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    padding: clamp(1rem, 2.4vw, 2rem);
    background: var(--color-bg);
    transition:
      background var(--duration-fast) var(--easing),
      transform var(--duration-fast) var(--easing);
  }

  .matrix-grid article:hover {
    background: #e9e6dc;
    transform: translateY(-2px);
  }

  .matrix-grid p {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .matrix-grid h3 {
    max-width: 9ch;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 3.4rem);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: var(--display-tracking-tight);
  }

  .matrix-grid span {
    max-width: 24ch;
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    line-height: 1.42;
    color: var(--color-muted);
  }

  .culture-visual--spiral {
    background: var(--color-bg);
  }

  .culture-diagram-block {
    display: grid;
    gap: clamp(1.2rem, 2.4vw, 2rem);
  }

  .culture-visual__media {
    position: relative;
    margin: 0;
    background: transparent;
  }

  .culture-visual__media img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .culture-visual--spiral .culture-visual__media img {
    aspect-ratio: 3 / 2;
  }

  .culture-visual__media--wide img {
    aspect-ratio: 16 / 9;
  }

  .diamond-expansion {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  .diamond-expansion path,
  .diamond-expansion circle {
    vector-effect: non-scaling-stroke;
  }

  .diamond-expansion__field {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.35;
    stroke-linecap: round;
    opacity: 0.42;
  }

  .diamond-expansion__field--inner {
    stroke-width: 0.95;
    opacity: 0.28;
  }

  .diamond-expansion__dash {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 0.85;
    stroke-linecap: round;
    stroke-dasharray: 6 7;
    opacity: 0.34;
  }

  .diamond-expansion circle {
    fill: var(--color-accent);
    opacity: 0.58;
  }

  .diamond-notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border-block: 1px solid rgba(17, 17, 17, 0.22);
    background: rgba(17, 17, 17, 0.22);
  }

  .diamond-notes li {
    min-height: 7.5rem;
    display: flex;
    align-items: flex-end;
    padding: clamp(1rem, 2vw, 1.35rem);
    background: var(--color-bg);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.45rem);
    line-height: 1.08;
    letter-spacing: var(--display-tracking);
  }

  .ai-quote-section {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .ai-quote-section .culture-label {
    color: rgba(242, 240, 234, 0.62);
  }

  .ai-quote-section blockquote {
    display: grid;
    gap: clamp(1.4rem, 3vw, 2.6rem);
    margin: 0;
  }

  .ai-quote-section blockquote p {
    max-width: 15ch;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 6.4rem);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: var(--display-tracking-tight);
  }

  .ai-quote-section cite,
  .ai-quote-section__note {
    max-width: 36rem;
    font-family: var(--font-body);
    font-size: clamp(0.98rem, 1.3vw, 1.15rem);
    font-style: normal;
    line-height: 1.45;
    color: rgba(242, 240, 234, 0.7);
  }

  .ai-quote-section cite a {
    border-bottom: 1px solid rgba(242, 240, 234, 0.54);
  }

  .ai-quote-section__note {
    grid-column: 2;
    color: var(--color-bg);
  }

  .culture-close {
    padding-bottom: clamp(5rem, 9vw, 9rem);
  }

  .culture-close ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-content: start;
  }

  .culture-close li {
    border: 1px solid rgba(17, 17, 17, 0.34);
    border-radius: 999px;
    padding: 0.66rem 0.94rem 0.58rem;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.8rem);
    line-height: 1;
    letter-spacing: var(--display-tracking);
  }

  .culture-close a {
    grid-column: 2;
    width: fit-content;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1;
    letter-spacing: var(--display-tracking);
  }

  @media (prefers-reduced-motion: reduce) {
    .matrix-grid article {
      transition: none;
    }

    .matrix-grid article:hover {
      transform: none;
    }
  }

  @media (max-width: 980px) {
    .culture-hero__inner,
    .culture-section-grid,
    .culture-visual__inner,
    .ai-quote-section__inner,
    .culture-close__inner {
      grid-template-columns: 1fr;
    }

    .culture-section-heading {
      position: static;
    }

    .ai-quote-section__note,
    .culture-close a {
      grid-column: auto;
    }
  }

  @media (max-width: 680px) {
    .culture-hero {
      min-height: calc(88dvh - 72px);
      padding-block: var(--space-5);
    }

    .culture-hero h1 {
      font-size: clamp(3.15rem, 15vw, 5.4rem);
    }

    .culture-matrix {
      min-height: auto;
      padding: 2.4rem 0 3.1rem;
    }

    .culture-matrix::before,
    .culture-matrix::after {
      display: none;
    }

    .matrix-axis--left,
    .matrix-axis--right {
      display: none;
    }

    .matrix-axis--top,
    .matrix-axis--bottom {
      left: 0;
      transform: none;
    }

    .matrix-grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .matrix-grid article {
      min-height: 13rem;
    }

    .culture-section-heading h2,
    .culture-close h2 {
      font-size: clamp(2.25rem, 11vw, 4rem);
    }

    .ai-quote-section blockquote p {
      max-width: 100%;
      font-size: clamp(2.3rem, 10vw, 4.2rem);
    }

    .diamond-notes {
      grid-template-columns: 1fr;
    }

    .diamond-notes li {
      min-height: 5.2rem;
    }
  }
</style>
