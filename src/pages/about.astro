---
import BaseLayout from '../layouts/BaseLayout.astro';

const founders = [
  {
    name: 'Marco Ricci',
    role: 'Strategy & Ventures',
    bio: 'Marco spent a decade building and exiting startups across Southern Europe before co-founding Estro. He believes the best thing you can do for a team is show up and stay honest.',
    tint: 'linear-gradient(170deg, #dddad0 0%, #ccc8bc 100%)',
  },
  {
    name: 'Sara Lundqvist',
    role: 'Design & Product',
    bio: 'Sara has led product design at companies from Stockholm to São Paulo. She is interested in how tools shape thinking — and how good design makes space for better decisions.',
    tint: 'linear-gradient(170deg, #d5d2c7 0%, #c6c2b4 100%)',
  },
];
---

<BaseLayout
  title="About"
  description="Estro — who we are, our mission, and the story behind the name."
>

  <section class="page-header">
    <div class="container">
      <h1 class="page-title">About</h1>
    </div>
  </section>

  <hr class="rule" />

  <!-- Mission -->
  <section class="section" aria-labelledby="mission-heading">
    <div class="container">
      <p id="mission-heading" class="section-label">Mission</p>
      <p class="lead-text" style="max-width: 32ch;">
        The best ideas don't come from offices. We believe in proximity to the problem — showing up where the work happens, staying until something real gets made.
      </p>
    </div>
  </section>

  <hr class="rule" />

  <!-- Founders -->
  <section class="section" aria-labelledby="founders-heading">
    <div class="container">
      <p id="founders-heading" class="section-label">Founders</p>
      <ul class="founders-grid" role="list">
        {founders.map((f) => (
          <li class="founder-card">
            <div
              class="founder-card__photo"
              style={`background: ${f.tint};`}
              aria-hidden="true"
            ></div>
            <div class="founder-card__info">
              <p class="founder-card__name">{f.name}</p>
              <p class="founder-card__role">{f.role}</p>
              <p class="founder-card__bio">{f.bio}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <hr class="rule" />

  <!-- Story -->
  <section class="section" aria-labelledby="story-heading">
    <div class="container">
      <p id="story-heading" class="section-label">Story</p>
      <div class="story-body">
        <p class="story-intro">
          Estro started as a question: what if the best thing a team could have was someone genuinely outside it?
        </p>
        <p class="body-text">
          Marco and Sara met during a product sprint in Lisbon in 2021. They disagreed on almost everything — which turned out to be exactly right. They launched Estro the following year, with no office, no fixed clients, and a single operating principle: go where the problem is, stay until something real gets made.
        </p>
        <p class="body-text">
          The word <em>estro</em> means inspiration in Italian — the sudden impulse that makes you create. That is the spirit we try to bring to every engagement.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-header { padding-block: var(--space-5); }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .section { padding-block: var(--space-6); }

  .lead-text {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 400;
    line-height: 1.3;
  }

  /* Founders */
  .founders-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .founder-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .founder-card__photo {
    aspect-ratio: 3 / 4;
    width: 100%;
    max-width: 400px;
    overflow: hidden;
  }

  .founder-card__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    margin-bottom: var(--space-1);
  }

  .founder-card__role {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }

  .founder-card__bio {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-muted);
    line-height: 1.75;
    max-width: 40ch;
  }

  /* Story */
  .story-body {
    max-width: 60ch;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .story-intro {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.75rem);
    font-weight: 400;
    line-height: 1.35;
  }

  .body-text {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-muted);
    line-height: 1.75;
  }
</style>
