---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/editorial-pages.css';

const founders = [
  {
    name: 'Marco Ricci',
    role: 'Strategy & Ventures',
    bio: 'Strategy, ventures, and operating clarity for work that needs momentum.',
    tint: 'linear-gradient(170deg, #ddd9cf 0%, #c9c4b6 100%)',
  },
  {
    name: 'Sara Lundqvist',
    role: 'Design & Product',
    bio: 'Product design, systems thinking, and editorial precision.',
    tint: 'linear-gradient(170deg, #d6d1c6 0%, #c4beaf 100%)',
  },
];

const values = [
  'Outside perspective without outsider distance.',
  'High standards without performative polish.',
  'Creative ambition that survives contact with reality.',
];
---

<BaseLayout
  title="About"
  description="Who Estro is, why it exists, and what kind of studio it is becoming."
>
  <div class="editorial-page">
    <section class="editorial-hero">
      <div class="container editorial-grid">
        <div class="editorial-rail" data-reveal="hero-meta">
          <p class="section-label">About</p>
          <p class="editorial-rail-note">A small studio for strategic and creative work.</p>
        </div>

        <div class="editorial-main" data-reveal="hero-content">
          <h1 class="editorial-title">A compact studio for useful creative work.</h1>
          <p class="editorial-intro">
            Close to the problem, careful with the form, accountable to the result.
          </p>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Mission</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">Better moves while the ground is still shifting.</h2>
          <div class="editorial-columns">
            <p class="editorial-lead">
              We help teams frame what matters and turn abstract ambition into something durable.
            </p>
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Founders</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">Two practices, one shared standard.</h2>
          <div class="editorial-card-grid founders-grid">
            {founders.map((founder) => (
              <article class="editorial-card founder-card" data-reveal="card">
                <div class="editorial-card__visual" style={`background:${founder.tint};`}></div>
                <div class="founder-card__copy">
                  <p class="editorial-card__title">{founder.name}</p>
                  <p class="editorial-card__meta">{founder.role}</p>
                  <p class="editorial-card__body">{founder.bio}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Character</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">Simple on purpose.</h2>
          <div class="editorial-list">
            {values.map((value, index) => (
              <article class="editorial-row" data-reveal="row">
                <p class="editorial-row__index">0{index + 1}</p>
                <div class="editorial-row__content">
                  <h3 class="editorial-row__title">{value}</h3>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .founders-grid {
    align-items: stretch;
  }

  .founder-card {
    justify-content: flex-start;
  }

  .founder-card__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .founder-card .editorial-card__visual {
    aspect-ratio: 3 / 4;
  }
</style>
