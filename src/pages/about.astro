---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/editorial-pages.css';

const founders = [
  {
    name: 'Marco Ricci',
    role: 'Strategy & Ventures',
    bio: 'Marco spent a decade building and exiting startups across Southern Europe before co-founding Estro. He cares about strategic clarity, honest operating choices, and work that earns its momentum.',
    tint: 'linear-gradient(170deg, #ddd9cf 0%, #c9c4b6 100%)',
  },
  {
    name: 'Sara Lundqvist',
    role: 'Design & Product',
    bio: 'Sara has led product design from Stockholm to Sao Paulo. She brings a systems eye, editorial rigor, and a strong instinct for where better design creates better judgment.',
    tint: 'linear-gradient(170deg, #d6d1c6 0%, #c4beaf 100%)',
  },
];

const values = [
  'Outside perspective without outsider distance.',
  'High standards without performative polish.',
  'Creative ambition that survives contact with reality.',
];
---

<BaseLayout
  title="About"
  description="Who Estro is, why it exists, and what kind of studio it is becoming."
>
  <div class="editorial-page">
    <section class="editorial-hero">
      <div class="container editorial-grid">
        <div class="editorial-rail" data-reveal="hero-meta">
          <p class="section-label">About</p>
          <p class="editorial-rail-note">A small studio designed for high-trust work in moments that need both strategic depth and creative precision.</p>
        </div>

        <div class="editorial-main" data-reveal="hero-content">
          <h1 class="editorial-title">We built Estro for work that needs closeness, range, and a useful outside point of view.</h1>
          <p class="editorial-intro">
            The studio is intentionally compact. That lets us stay senior, involved, and accountable to the work rather than protected from it.
          </p>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Mission</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">To help teams make better moves while the ground is still shifting.</h2>
          <div class="editorial-columns">
            <p class="editorial-lead">
              We believe the best ideas are rarely produced at a safe distance. They emerge in the middle of constraint, momentum, disagreement, and unfinished information.
            </p>
            <div class="editorial-content">
              <p class="editorial-text">
                Estro exists to work inside those conditions without making them heavier. We help teams frame what matters, make stronger decisions, and turn abstract ambition into something more durable.
              </p>
              <p class="editorial-quote">We are less interested in looking like a studio than in behaving like one when the work gets difficult.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Founders</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">Two practices, one shared standard for what useful work should feel like.</h2>
          <div class="editorial-card-grid founders-grid">
            {founders.map((founder) => (
              <article class="editorial-card founder-card" data-reveal="card">
                <div class="editorial-card__visual" style={`background:${founder.tint};`}></div>
                <div class="founder-card__copy">
                  <p class="editorial-card__title">{founder.name}</p>
                  <p class="editorial-card__meta">{founder.role}</p>
                  <p class="editorial-card__body">{founder.bio}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Character</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">The culture of the studio is simple on purpose.</h2>
          <div class="editorial-list">
            {values.map((value, index) => (
              <article class="editorial-row" data-reveal="row">
                <p class="editorial-row__index">0{index + 1}</p>
                <div class="editorial-row__content">
                  <h3 class="editorial-row__title">{value}</h3>
                  <p class="editorial-row__body">
                    We try to keep the studio honest by returning to this standard in how we scope, write, design, and collaborate. If the work cannot stand up outside the room, it is not finished.
                  </p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .founders-grid {
    align-items: stretch;
  }

  .founder-card {
    justify-content: flex-start;
  }

  .founder-card__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .founder-card .editorial-card__visual {
    aspect-ratio: 3 / 4;
  }
</style>
