---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---

<BaseLayout
  title="Projects"
  description="Selected Estro work across product, systems, culture, and future-facing initiatives."
  showFooter={false}
>
  <section class="projects-page">
    <div class="container">
      <div class="project-grid">
        {projects.map((project) => (
          <a href={`/projects/${project.slug}`} class="project-card">
            {project.images[0] ? (
              <img
                src={project.images[0]}
                alt=""
                class="project-card__visual"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="project-card__visual" style={`background:${project.tint};`}></div>
            )}
            <div class="project-card__shade"></div>
            <div class="project-card__copy">
              <h2 class="project-card__title">{project.title}</h2>
              <p class="project-card__summary">{project.summary}</p>
              <ul class="project-card__tags" aria-label={`${project.title} tags`}>
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(#main-content) {
    padding-top: 72px !important;
  }

  .projects-page {
    padding-block: var(--space-3) clamp(3rem, 8vw, 6rem);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 1.65vw, 1.5rem);
  }

  .project-card {
    position: relative;
    display: block;
    aspect-ratio: 18 / 16;
    overflow: hidden;
    border-radius: 8px;
    background: #d8d5ca;
    color: var(--color-bg);
    text-decoration: none;
    isolation: isolate;
  }

  .project-card__visual {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(155deg, #dfdcd2 0%, #cfcabc 100%);
    object-fit: cover;
    filter: saturate(0.94);
    transition:
      filter var(--duration-fast) var(--easing),
      transform 360ms ease;
  }

  .project-card:hover .project-card__visual {
    filter: saturate(1.08);
    transform: scale(1.025);
  }

  .project-card__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0) 18%, rgba(0, 0, 0, 0.18) 48%, rgba(0, 0, 0, 0.78) 100%);
    pointer-events: none;
  }

  .project-card__copy {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(0.8rem, 1.4vw, 1.1rem);
    padding: clamp(1.35rem, 3.8vw, 3.75rem);
  }

  .project-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 3.75rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 0;
    color: currentColor;
    text-wrap: balance;
  }

  .project-card__summary {
    max-width: 40rem;
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.25vw, 1.1rem);
    line-height: 1.45;
    color: currentColor;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .project-card__tags li {
    border: 1px solid rgba(242, 240, 234, 0.68);
    border-radius: 999px;
    padding: 0.38rem 0.78rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: 1;
    color: currentColor;
    background: rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(10px);
  }

  @media (max-width: 980px) {
    .project-card {
      aspect-ratio: 18 / 17;
    }
  }

  @media (max-width: 760px) {
    .projects-page {
      padding-block: var(--space-3) var(--space-5);
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      aspect-ratio: 1 / 1.05;
    }

    .project-card__copy {
      padding: var(--space-4);
    }

    .project-card__summary {
      font-size: var(--text-sm);
    }
  }
</style>
