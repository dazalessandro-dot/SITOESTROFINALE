---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  { title: 'Kelp',        tags: ['Sustainable packaging', 'Residency', '2024'], tint: 'linear-gradient(155deg, #dde0d3 0%, #cfd2c5 100%)' },
  { title: 'Meridian',    tags: ['Urban mobility', 'Sprint', '2024'],           tint: 'linear-gradient(155deg, #d8dbd5 0%, #cacdc6 100%)' },
  { title: 'Forma',       tags: ['Design systems', 'Advisory', '2023'],         tint: 'linear-gradient(155deg, #d5d2c8 0%, #c7c4b9 100%)' },
  { title: 'Tidal',       tags: ['Clean energy', 'Venture', '2023'],            tint: 'linear-gradient(155deg, #d2d0c6 0%, #c5c2b7 100%)' },
  { title: 'Nomad Stack', tags: ['Distributed work', 'Sprint', '2022'],         tint: 'linear-gradient(155deg, #cfcdc3 0%, #c2c0b5 100%)' },
  { title: 'Atlas',       tags: ['Knowledge platforms', 'Residency', '2022'],   tint: 'linear-gradient(155deg, #cccac0 0%, #bfbdb2 100%)' },
];
---

<BaseLayout
  title="Projects"
  description="A selection of projects from Estro's nomadic innovation practice."
>

  <section class="page-header">
    <div class="container">
      <h1 class="page-title">Projects</h1>
    </div>
  </section>

  <hr class="rule" />

  <section class="section" aria-label="Project listing">
    <div class="container">
      <ul class="projects-grid" role="list">
        {projects.map((p) => (
          <li class="project-card">
            <a href="#" class="project-card__link">
              <div class="project-card__media" style={`background: ${p.tint};`}>
                <!-- TODO: replace with <picture> when images are ready -->
              </div>
              <p class="project-card__title">{p.title}</p>
              <div class="project-card__tags">
                {p.tags.map((tag) => (
                  <span class="project-card__tag">{tag}</span>
                ))}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>

<style>
  .page-header { padding-block: var(--space-5); }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .section { padding-block: var(--space-6); }

  /* Grid */
  .projects-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }

  /* Card */
  .project-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: var(--space-3);
    transition: transform 400ms ease;
  }

  .project-card__link:hover .project-card__media {
    transform: scale(1.02);
  }

  .project-card__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    margin-bottom: var(--space-2);
  }

  .project-card__tags {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .project-card__tag {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>
