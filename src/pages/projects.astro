---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Projects"
  description="A selection of projects from Estro's nomadic innovation hub."
>

  <!-- Page header -->
  <section class="page-header section">
    <div class="container">
      <h1 class="page-title">Projects</h1>
      <!-- TODO: content — optional intro sentence -->
    </div>
  </section>

  <!-- =====================================================
       PROJECTS GRID  (6 stubs)
       Responsive: 1 col → 2 col (tablet) → 3 col (desktop)
       ===================================================== -->
  <section class="section projects-section" aria-label="Project listing">
    <div class="container">
      <ul class="projects-grid" role="list">
        {Array.from({ length: 6 }).map((_, i) => (
          <li class="project-card">
            <a href="#" class="project-card__link" aria-label={`Project ${i + 1} — placeholder`}>

              <!-- Image container: aspect ratio locked so grid is stable -->
              <div class="project-card__media" aria-hidden="true">
                <!-- TODO: content — project {i + 1} image
                     <picture>
                       <source srcset="project-{i}.avif" type="image/avif" />
                       <source srcset="project-{i}.webp" type="image/webp" />
                       <img src="project-{i}.jpg" alt="…" loading="lazy"
                            decoding="async" width="800" height="600" />
                     </picture>
                -->
                <div class="placeholder project-card__placeholder">Image {i + 1}</div>
              </div>

              <div class="project-card__meta">
                <!-- TODO: content — project {i + 1} title + tags -->
                <p class="placeholder project-card__title">Project title {i + 1}</p>
              </div>

            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>

<style>
  .page-header { padding-block-end: 0; }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  /* --- Grid -------------------------------------------------- */
  .projects-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;             /* mobile: 1 col  */
  }

  @media (min-width: 640px) {
    .projects-grid { grid-template-columns: repeat(2, 1fr); }  /* tablet: 2 col */
  }

  @media (min-width: 1024px) {
    .projects-grid { grid-template-columns: repeat(3, 1fr); }  /* desktop: 3 col */
  }

  /* --- Card -------------------------------------------------- */
  .project-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-block-end: var(--space-3);
  }

  .project-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-card__meta { padding-inline: var(--space-1); }

  .project-card__title { margin: 0; }

  /* Hover: subtle lift on the image */
  .project-card__link:hover .project-card__media,
  .project-card__link:focus-visible .project-card__media {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .project-card__link:focus-visible {
    outline: none; /* outline on media instead */
  }
</style>
