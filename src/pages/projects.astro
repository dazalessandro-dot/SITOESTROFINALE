---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/editorial-pages.css';

const metrics = [
  { value: '12+', label: 'initiatives shaped across product, culture, and new venture contexts' },
  { value: '4', label: 'core working modes, adapted to the pace and politics of the team' },
  { value: '1', label: 'shared standard: work that remains credible after the workshop ends' },
];

const projects = [
  { title: 'Kelp', sector: 'Sustainable packaging', format: 'Residency', year: '2024', summary: 'A cross-functional program to reframe packaging as a product and systems problem rather than a material choice.', tint: 'linear-gradient(155deg, #dde0d3 0%, #cfd2c5 100%)' },
  { title: 'Meridian', sector: 'Urban mobility', format: 'Sprint', year: '2024', summary: 'A compressed decision sprint to align service, policy, and user experience around a new public-facing offer.', tint: 'linear-gradient(155deg, #d8dbd5 0%, #cacdc6 100%)' },
  { title: 'Forma', sector: 'Design systems', format: 'Advisory', year: '2023', summary: 'A long-view collaboration that translated scaling pain into a clearer product language and a working governance model.', tint: 'linear-gradient(155deg, #d5d2c8 0%, #c7c4b9 100%)' },
  { title: 'Tidal', sector: 'Clean energy', format: 'Venture', year: '2023', summary: 'An early-stage proposition shaped through positioning, ecosystem mapping, and concrete experience concepts.', tint: 'linear-gradient(155deg, #d2d0c6 0%, #c5c2b7 100%)' },
  { title: 'Nomad Stack', sector: 'Distributed work', format: 'Sprint', year: '2022', summary: 'A research-led engagement exploring what operational trust needs to look like in globally distributed teams.', tint: 'linear-gradient(155deg, #cfcdc3 0%, #c2c0b5 100%)' },
  { title: 'Atlas', sector: 'Knowledge platforms', format: 'Residency', year: '2022', summary: 'A platform rethink shaped around editorial hierarchy, contribution flows, and more resilient collaboration patterns.', tint: 'linear-gradient(155deg, #cccac0 0%, #bfbdb2 100%)' },
];
---

<BaseLayout
  title="Projects"
  description="Selected Estro work across product, systems, culture, and future-facing initiatives."
>
  <div class="editorial-page">
    <section class="editorial-hero">
      <div class="container editorial-grid">
        <div class="editorial-rail" data-reveal="hero-meta">
          <p class="section-label">Projects</p>
          <p class="editorial-rail-note">A selection of work shaped through proximity, strong framing, and an editorial approach to complexity.</p>
        </div>

        <div class="editorial-main" data-reveal="hero-content">
          <h1 class="editorial-title editorial-title--wide">Projects where strategy, systems, and experience had to move together.</h1>
          <p class="editorial-intro">
            The specifics change from client to client. The throughline is usually the same: a difficult transition, an unclear opportunity, or a team that needs a stronger shared shape for the work.
          </p>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Context</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">Different sectors, same preference for work that can survive implementation.</h2>
          <div class="editorial-metric-grid">
            {metrics.map((metric) => (
              <article class="editorial-metric" data-reveal="card">
                <p class="editorial-metric__value">{metric.value}</p>
                <p class="editorial-metric__label">{metric.label}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Selected work</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <div class="editorial-card-grid project-grid">
            {projects.map((project) => (
              <article class="editorial-card project-card" data-reveal="card">
                <div class="editorial-card__visual" style={`background:${project.tint};`}></div>
                <div class="project-card__copy">
                  <p class="editorial-card__meta">{project.sector} / {project.format} / {project.year}</p>
                  <p class="editorial-card__title">{project.title}</p>
                  <p class="editorial-card__body">{project.summary}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .project-grid .editorial-card__visual {
    aspect-ratio: 4 / 3;
  }

  .project-card {
    justify-content: flex-start;
  }

  .project-card__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
