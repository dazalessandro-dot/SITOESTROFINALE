---
import BaseLayout from '../layouts/BaseLayout.astro';

const workshopImages = [
  {
    src: '/projects/workshop-team-building-unicredit/1.jpg',
    alt: 'Large corporate group gathered around workshop tables at Mare Culturale Urbano during an Estro team-building session.',
  },
  {
    src: '/projects/workshop-team-building-unicredit/2.jpg',
    alt: 'Participants painting by hand during the street art team workshop.',
  },
  {
    src: '/projects/workshop-team-building-unicredit/3.jpg',
    alt: 'Participants presenting a colourful artwork created during the workshop.',
  },
  {
    src: '/projects/workshop-team-building-unicredit/4.jpg',
    alt: 'Workshop materials arranged on a long table before the activity starts.',
  },
  {
    src: '/projects/workshop-team-building-unicredit/5.jpg',
    alt: 'Workshop room prepared with tables, canvases and materials for a large team activity.',
  },
];

const paths = [
  {
    title: 'Street art alignment',
    text: 'Company values and priorities become one collective artwork.',
  },
  {
    title: 'Tailored workshop',
    text: 'A new hands-on format shaped around your team objective.',
  },
];

const faqs = [
  {
    question: 'Do participants need artistic experience?',
    answer: 'No. The workshop is designed so that everyone can participate. The creative activity is a tool for collaboration, not a test of artistic ability.',
  },
  {
    question: 'How many people can take part?',
    answer: 'The format is ideal for groups of around 80-100 people and can be adapted for up to 150 participants.',
  },
  {
    question: 'How long does the workshop last?',
    answer: 'The typical format runs from 9:00 until lunchtime, followed by lunch together when included in the programme.',
  },
  {
    question: 'Can the workshop be customised?',
    answer: 'Yes. We can adapt the street art format or design a different hands-on workshop around a specific team objective, company theme or strategic moment.',
  },
  {
    question: 'Where does it take place?',
    answer: 'Our Milan workshops are usually hosted with our partner Mare Culturale Urbano.',
  },
  {
    question: 'Can lunch be included?',
    answer: 'Yes. The morning can conclude with lunch at Mare Culturale Urbano, creating a more informal closing moment for the team.',
  },
];
---

<BaseLayout
  title="Team workshops in Milan"
  description="Hands-on team workshops in Milan by Estro. Street art and tailored creative formats for departments and groups of up to 150 participants."
>
  <article class="workshops-page">
    <section class="workshop-hero">
      <div class="container workshop-hero__inner">
        <div class="workshop-hero__copy" data-reveal="hero-content">
          <p class="workshop-label">TEAM WORKSHOPS</p>
          <h1>Make something together. See your team differently.</h1>
          <p class="workshop-hero__body">Hands-on workshops for teams that need to align, decide, and create a visible shared outcome.</p>
          <p class="workshop-hero__meta">Milan · Up to 150 participants · Morning format</p>
          <div class="workshop-actions">
            <a class="workshop-button workshop-button--primary" href="/contact">Plan a workshop <span aria-hidden="true">→</span></a>
            <a class="workshop-button workshop-button--secondary" href="#format">See how it works <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <figure class="workshop-hero__media" data-reveal="hero-meta">
          <img src={workshopImages[0].src} alt={workshopImages[0].alt} loading="eager" decoding="async" />
        </figure>
      </div>
    </section>

    <section id="format" class="flagship-section">
      <div class="container flagship-section__inner">
        <div class="flagship-section__copy">
          <p class="workshop-label">ONE POSSIBLE FORMAT</p>
          <h2>Team alignment through street art.</h2>
          <div class="workshop-prose">
            <p>Teams turn company values, priorities, or a shared transition into one collective artwork. No artistic experience is needed: the point is how people listen, choose, and build together.</p>
          </div>
        </div>

        <div class="flagship-gallery" aria-label="Workshop images">
          <figure class="flagship-gallery__large">
            <img src={workshopImages[1].src} alt={workshopImages[1].alt} loading="lazy" decoding="async" />
          </figure>
          <figure>
            <img src={workshopImages[3].src} alt={workshopImages[3].alt} loading="lazy" decoding="async" />
          </figure>
          <figure>
            <img src={workshopImages[2].src} alt={workshopImages[2].alt} loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class="custom-section">
      <div class="container custom-section__inner">
        <div class="custom-section__media">
          <img src={workshopImages[1].src} alt={workshopImages[1].alt} loading="lazy" decoding="async" />
        </div>
        <div class="custom-section__copy">
          <p class="workshop-label">CUSTOMISATION</p>
          <h2>The format starts from your team.</h2>
          <div class="workshop-prose">
            <p>We start from your objective, then adapt the brief, prompts, group structure, and final outcome. Best for departments and business units of 80-100 people, scalable up to 150.</p>
          </div>
          <div class="path-list">
            {paths.map((path) => (
              <article>
                <h3>{path.title}</h3>
                <p>{path.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="location-section">
      <div class="container location-section__inner">
        <figure class="location-section__media">
          <img src={workshopImages[4].src} alt={workshopImages[4].alt} loading="lazy" decoding="async" />
        </figure>
        <div>
          <p class="workshop-label">IN MILAN</p>
          <h2>Our workshop partner in Milan.</h2>
          <p>Milan workshops can be hosted with Mare Culturale Urbano, with space for large groups, hands-on work, and lunch together.</p>
          <a class="text-link" href="https://maremilano.org/affitto-spazi-2/" target="_blank" rel="noopener noreferrer">Discover Mare Culturale Urbano <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="closing-section">
      <div class="container closing-section__inner">
        <h2>Bring us the team. We'll design the morning.</h2>
        <div class="closing-section__copy">
          <p>Book a 15-minute call. If there is a fit, we follow up with a first workshop direction, structure, and indicative investment.</p>
          <div class="workshop-actions">
            <a class="workshop-button workshop-button--primary workshop-button--light" href="/contact">Book a 15-minute call <span aria-hidden="true">→</span></a>
            <a class="workshop-button workshop-button--secondary workshop-button--light" href="mailto:alessandro.daz@estro-studio.it">Write to us <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <div class="container faq-section__inner">
        <p class="workshop-label">FAQ</p>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .workshops-page {
    --workshop-pink: #ff3f6e;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .workshop-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .workshop-label--dark {
    color: rgba(242, 240, 234, 0.62);
  }

  .workshop-hero {
    min-height: calc(100dvh - 72px);
    display: grid;
    align-items: stretch;
    padding-block: clamp(1.5rem, 4vw, 3rem);
  }

  .workshop-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.48fr) minmax(0, 0.52fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: center;
  }

  .workshop-hero__copy {
    display: flex;
    flex-direction: column;
    gap: clamp(1.2rem, 2.4vw, 2.2rem);
  }

  .workshop-hero h1,
  .flagship-section h2,
  .custom-section h2,
  .location-section h2,
  .closing-section h2 {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: var(--display-tracking);
  }

  .workshop-hero h1 {
    max-width: 10ch;
    font-size: clamp(4rem, 8vw, 8.6rem);
    line-height: 0.88;
  }

  .workshop-hero__body {
    max-width: 37ch;
    font-size: clamp(1.12rem, 1.6vw, 1.45rem);
    line-height: 1.35;
  }

  .workshop-hero__meta {
    width: fit-content;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    padding-block: 0.72rem;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.5vw, 1.45rem);
    line-height: 1;
    letter-spacing: var(--display-tracking);
  }

  .workshop-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .workshop-button {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border: 1px solid var(--color-text);
    padding: 0.86rem 1rem 0.78rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1;
    letter-spacing: var(--display-tracking);
    transition: background var(--duration-fast) var(--easing), color var(--duration-fast) var(--easing);
  }

  .workshop-button--primary {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .workshop-button--secondary {
    background: transparent;
    color: var(--color-text);
  }

  .workshop-button:hover {
    background: var(--workshop-pink);
    color: var(--color-text);
  }

  .workshop-button--light {
    border-color: var(--color-bg);
  }

  .workshop-button--primary.workshop-button--light {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .workshop-button--secondary.workshop-button--light {
    color: var(--color-bg);
  }

  .workshop-hero__media {
    align-self: stretch;
    min-height: 520px;
    position: relative;
    overflow: hidden;
    background: #e3dfd5;
  }

  .workshop-hero__media::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 38%;
    background: linear-gradient(to top, rgba(17, 17, 17, 0.28), transparent);
    pointer-events: none;
  }

  .workshop-hero__media img,
  .custom-section__media img,
  .flagship-gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
  }

  .flagship-section,
  .custom-section,
  .location-section,
  .faq-section {
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .flagship-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.46fr) minmax(0, 0.54fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: start;
  }

  .flagship-section__copy,
  .custom-section__copy {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .flagship-section h2,
  .custom-section h2,
  .location-section h2 {
    max-width: 12ch;
    font-size: clamp(3.2rem, 6.6vw, 7rem);
    line-height: 0.9;
  }

  .workshop-prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 38rem;
    font-size: clamp(1.02rem, 1.35vw, 1.24rem);
    line-height: 1.5;
    color: var(--color-muted);
  }

  .text-link {
    width: fit-content;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.22rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.3vw, 1.22rem);
    line-height: 1;
    letter-spacing: var(--display-tracking);
  }

  .text-link:hover {
    color: var(--workshop-pink);
  }

  .flagship-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    align-items: end;
  }

  .flagship-gallery figure {
    min-height: 300px;
    overflow: hidden;
    background: #e3dfd5;
  }

  .flagship-gallery__large {
    grid-column: 1 / -1;
    min-height: 470px;
  }

  .location-section__inner,
  .closing-section__inner,
  .faq-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: start;
  }

  .custom-section {
    background: #e9e6dc;
  }

  .custom-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.44fr) minmax(0, 0.56fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: center;
  }

  .custom-section__media {
    min-height: 660px;
    overflow: hidden;
    background: #dedacf;
  }

  .path-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgba(17, 17, 17, 0.2);
    border: 1px solid rgba(17, 17, 17, 0.2);
  }

  .path-list article {
    min-height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    background: #e9e6dc;
    padding: clamp(1rem, 2.3vw, 2rem);
  }

  .path-list h3 {
    max-width: 9ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.8vw, 4.2rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: var(--display-tracking);
  }

  .path-list p,
  .location-section p {
    max-width: 40rem;
    font-size: clamp(1rem, 1.28vw, 1.16rem);
    line-height: 1.5;
    color: var(--color-muted);
  }

  .location-section {
    border-bottom: 1px solid rgba(17, 17, 17, 0.16);
  }

  .location-section__media {
    min-height: 420px;
    overflow: hidden;
    background: #dedacf;
  }

  .location-section__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
  }

  .location-section__inner > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .closing-section {
    background: var(--color-text);
    color: var(--color-bg);
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .closing-section h2 {
    max-width: 10ch;
    font-size: clamp(3.5rem, 8vw, 9rem);
    line-height: 0.86;
  }

  .closing-section__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 42rem;
    font-size: clamp(1.04rem, 1.42vw, 1.28rem);
    line-height: 1.45;
    color: rgba(242, 240, 234, 0.76);
  }

  .faq-list {
    border-top: 1px solid var(--color-rule);
  }

  .faq-list details {
    border-bottom: 1px solid var(--color-rule);
  }

  .faq-list summary {
    cursor: pointer;
    padding-block: 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 2rem);
    line-height: 1.05;
    letter-spacing: var(--display-tracking);
  }

  .faq-list summary::marker {
    color: var(--workshop-pink);
  }

  .faq-list p {
    max-width: 42rem;
    padding: 0 0 var(--space-4);
    font-size: clamp(0.98rem, 1.2vw, 1.08rem);
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (max-width: 980px) {
    .workshop-hero__inner,
    .flagship-section__inner,
    .custom-section__inner,
    .location-section__inner,
    .closing-section__inner,
    .faq-section__inner {
      grid-template-columns: 1fr;
    }

    .workshop-hero {
      min-height: auto;
    }

    .workshop-hero h1,
    .flagship-section h2,
    .custom-section h2,
    .location-section h2,
    .closing-section h2 {
      max-width: 12ch;
    }

    .workshop-hero__media,
    .custom-section__media {
      min-height: auto;
      aspect-ratio: 4 / 3;
    }

  }

  @media (max-width: 700px) {
    .workshop-hero {
      padding-block: var(--space-4);
    }

    .workshop-hero h1 {
      font-size: clamp(3.3rem, 15vw, 5.4rem);
    }

    .workshop-actions,
    .workshop-button {
      width: 100%;
    }

    .workshop-button {
      justify-content: space-between;
    }

    .flagship-gallery,
    .path-list {
      grid-template-columns: 1fr;
    }

    .flagship-gallery figure,
    .flagship-gallery__large {
      min-height: auto;
      aspect-ratio: 4 / 3;
    }

    .path-list article {
      min-height: 220px;
    }
  }
</style>
