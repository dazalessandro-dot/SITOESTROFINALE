---
import BaseLayout from '../layouts/BaseLayout.astro';
import { shopItems } from '../data/shop';
---

<BaseLayout
  title="Shop"
  description="Our in-house designed and produced creative gear."
  showFooter={false}
>
  <section class="shop-page">
    <div class="container">
      <header class="shop-intro">
        <h1 class="shop-title">our in-house designed and produced creative gear</h1>
        <a class="shop-discover" href="#shop-grid">discover more</a>
      </header>

      <div id="shop-grid" class="shop-grid" aria-label="Shop products">
        {shopItems.map((item) => (
          <article class="shop-card">
            <img
              src={item.images[0]}
              alt=""
              class="shop-card__visual"
              loading="lazy"
              decoding="async"
            />
            <div class="shop-card__meta">
              <div>
                <p class="shop-card__title">{item.title}</p>
                <p class="shop-card__description">{item.description}</p>
              </div>
              <p class="shop-card__status">{item.status}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .shop-page {
    padding-block: clamp(2rem, 4vw, 3.25rem) clamp(3rem, 6vw, 5rem);
  }

  .shop-intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .shop-title {
    max-width: none;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 3.15rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: var(--display-tracking-tight);
    color: var(--color-text);
    white-space: nowrap;
  }

  .shop-discover {
    flex: 0 0 auto;
    border: 1px solid rgba(17, 17, 17, 0.38);
    border-radius: 999px;
    padding: 0.72rem 1rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1;
    color: var(--color-text);
    text-decoration: none;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .shop-discover:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .shop-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: rgba(17, 17, 17, 0.18);
    scroll-margin-top: 88px;
  }

  .shop-card {
    background: var(--color-bg);
    padding: clamp(0.9rem, 1.8vw, 1.4rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .shop-card__visual {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: linear-gradient(155deg, #dfdcd2 0%, #cfcabc 100%);
    object-fit: cover;
  }

  .shop-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .shop-card__title {
    margin-bottom: var(--space-1);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1;
    color: var(--color-text);
  }

  .shop-card__description {
    color: var(--color-muted);
  }

  .shop-card__status {
    width: fit-content;
    border: 1px solid rgba(17, 17, 17, 0.42);
    border-radius: 999px;
    padding: 0.38rem 0.72rem;
    font-size: var(--text-xs);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  @media (max-width: 980px) {
    .shop-intro {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-3);
    }

    .shop-title {
      white-space: normal;
    }

    .shop-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .shop-page {
      padding-block: var(--space-4);
    }

    .shop-title {
      font-size: clamp(1.75rem, 8vw, 2.55rem);
      line-height: 1.05;
    }

    .shop-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
