---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/editorial-pages.css';

const items = [
  { title: 'Estro Tote', price: '€28', note: 'Heavy cotton / field-ready carry', tint: 'linear-gradient(155deg, #e2dfd4 0%, #d4d0c3 100%)' },
  { title: 'Residency Zine Vol. 1', price: '€18', note: 'Printed notes from embedded work', tint: 'linear-gradient(155deg, #d9d5ca 0%, #cbc7b9 100%)' },
  { title: 'Nomad Field Notes', price: '€12', note: 'Pocket notebook for loose thinking', tint: 'linear-gradient(155deg, #d4d1c6 0%, #c7c3b5 100%)' },
  { title: 'Estro Print — Lisbon', price: '€45', note: 'Edition print from the studio archive', tint: 'linear-gradient(155deg, #cfccc1 0%, #c2beaf 100%)' },
];
---

<BaseLayout
  title="Shop"
  description="Small-run objects and editions from Estro."
>
  <div class="editorial-page">
    <section class="editorial-hero">
      <div class="container editorial-grid">
        <div class="editorial-rail" data-reveal="hero-meta">
          <p class="section-label">Shop</p>
          <p class="editorial-rail-note">A small set of studio objects and editions. Useful, light, and intentionally limited.</p>
        </div>

        <div class="editorial-main" data-reveal="hero-content">
          <h1 class="editorial-title">Objects that carry the same tone as the work: precise, quiet, and made in small runs.</h1>
          <p class="editorial-intro">
            The shop is not merchandise in the usual sense. It is a place for working artifacts, printed matter, and small-format pieces connected to the studio’s practice.
          </p>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Editions</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <div class="editorial-card-grid shop-grid">
            {items.map((item) => (
              <article class="editorial-card shop-card" data-reveal="card">
                <div class="editorial-card__visual" style={`background:${item.tint};`}></div>
                <div class="shop-card__copy">
                  <p class="editorial-card__title">{item.title}</p>
                  <div class="editorial-card__footer">
                    <p class="editorial-card__body">{item.note}</p>
                    <p class="editorial-card__meta">{item.price}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section class="editorial-section" data-reveal="chapter">
      <div class="container editorial-grid">
        <div class="editorial-rail editorial-rail--sticky" data-reveal="rail">
          <p class="section-label">Shipping</p>
        </div>

        <div class="editorial-content" data-reveal="content">
          <h2 class="editorial-headline">Packed lightly, shipped monthly, and handled by the studio wherever we are working from.</h2>
          <p class="editorial-text">
            We keep the shop intentionally small so it remains an extension of the practice rather than a separate business. If something is listed, it means we can stand behind its quality and its reason for existing.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .shop-grid .editorial-card__visual {
    aspect-ratio: 1 / 1;
  }

  .shop-card {
    justify-content: flex-start;
  }

  .shop-card__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .shop-card .editorial-card__footer {
    align-items: flex-start;
  }
</style>
